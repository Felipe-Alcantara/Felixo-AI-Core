255m\u001b[1mResumo\u001b[m\u001b[K\r\n\u001b[K\r\n  \u001b[38;2;255;255;255mEste texto tem uma palavra em \u001b[1mnegrito\u001b[22m e outra em \u001b[3mitálico\u001b[23m, só para a gravação.\u001b[K\u001b[m\r\n\u001b[K\r\n   \u001b[38;2;255;255;255m- primeiro item\u001b[K\u001b[m\r\n   \u001b[38;2;255;255;255m- segundo item\u001b[K\u001b[m\r\n   \u001b[38;2;255;255;255m- terceiro item\u001b[K\u001b[m\r\n\u001b[K\r\n   \u001b[38;2;255;255;255m1. passo um\u001b[K\u001b[m\r\n   \u001b[38;2;255;255;255m2. passo dois\u001b[K\u001b[m\r\n\u001b[K\r\n   \u001b[38;2;175;175;175m1 \u001b[38;2;135;175;255mdef \u001b[38;2;255;255;255msoma(a, b):\u001b[K\u001b[m\r\n   \u001b[38;2;175;175;175m2     \u001b[38;2;135;175;255mreturn \u001b[38;2;255;255;255ma + b\u001b[K\u001b[m\r\n\u001b[K\r\n  \u001b[38;2;135;135;135m┌──────┬───────┐\u001b[K\u001b[m\r\n  \u001b[38;2;135;135;135m│ \u001b[38;2;135;175;255m\u001b[1mNome\u001b[m \u001b[38;2;135;135;135m│ \u001b[38;2;135;175;255m\u001b[1mValor\u001b[m \u001b[38;2;135;135;135m│\u001b[K\u001b[m\r\n  \u001b[38;2;135;135;135m├──────┼───────┤\u001b[K\u001b[m\r\n  \u001b[38;2;135;135;135m│ \u001b[38;2;255;255;255malfa \u001b[38;2;135;135;135m│ \u001b[38;2;255;255;255m1     \u001b[38;2;135;135;135m│\u001b[K\u001b[m\r\n  \u001b[38;2;135;135;135m│ \u001b[38;2;255;255;255mbeta \u001b[38;2;135;135;135m│ \u001b[38;2;255;255;255m2     \u001b[38;2;135;135;135m│\u001b[K\u001b[m\r\n  \u001b[38;2;135;135;135m└──────┴───────┘\u001b[K\u001b[m\r\n  \u001b[38;2;255;255;255m> Uma citação curta.\u001b[K\u001b[m\r\n\u001b[K\r\n  \u001b[38;2;255;255;255mVeja a documentação (\u001b[38;2;135;175;255mhttps://example.com/docs\u001b[38;2;255;255;255m).\u001b[K\u001b[m\r\n\u001b[K\r\n\u001b[K\u001b[38;2;215;175;255m\r\n⠋ \u001b[38;2;255;255;255mResuming session...\u001b[K\u001b[m\r\n\u001b[K\r\n\u001b[84X\u001b[38;2;175;175;175m\u001b[84C? for shortcuts \u001b[38;2;135;135;135m\u001b[2m\r\n─────────────────────────────────────────────────────────────────────────────