\u001b[K  blocos em Markdown, nesta ordem: um título de nível 2 \"Resumo\"; um parágrafo curto com uma\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;49m\u001b[K  palavra em negrito e outra em itálico; uma lista com três itens; uma lista numerada com dois\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;49m\u001b[K  itens; um bloco de código python com uma função soma; uma tabela com as colunas Nome e Valor e\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;49m\u001b[K  duas linhas; uma citação curta; e um link para https://example.com/docs.\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;49m\u001b[K\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;49m\u001b[K\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;49m\u001b[K\u001b[2m• \u001b[22m\u001b[1m## Resumo\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;49m\u001b[K\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;49m\u001b[K  Este é um \u001b[1mresumo\u001b[22m breve e \u001b[3mclaro\u001b[23m.\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;49m\u001b[K\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;49m\u001b[K  - Primeiro item\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;49m\u001b[K  - Segundo item\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;49m\u001b[K  - Terceiro item\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;49m\u001b[K\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;49m\u001b[K  \u001b[38;2;99;168;248;49m1. \u001b[39;49mPrimeiro passo\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;49m\u001b[K  \u001b[38;2;99;168;248;49m2. \u001b[39;49mSegundo passo\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;49m\u001b[K\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;49m\u001b[K  \u001b[38;2;203;166;247;49mdef\u001b[38;2;205;214;244;49m \u001b[38;2;137;180;250;49msoma\u001b[38;2;147;153;178;49m(\u001b[38;2;235;160;172;49ma\u001b[38;2;147;153;178;49m,\u001b[38;2;235;160;172;49m b\u001b[38;2;147;153;178;49m):\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;49m\u001b[K  \u001b[38;2;205;214;244;49m    \u001b[38;2;203;166;247;49mreturn\u001b[38;2;205;214;244;49m a \u001b[38;2;148;226;213;49m+\u001b[38;2;205;214;244;49m b\