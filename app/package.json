{
  "name": "felixo-ai-core",
  "private": true,
  "description": "Desktop app for orchestrating local AI CLIs.",
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "author": "Felipe Alcantara",
  "repository": {
    "type": "git",
    "url": "https://github.com/Felipe-Alcantara/Felixo-AI-Core.git"
  },
  "homepage": "https://github.com/Felipe-Alcantara/Felixo-AI-Core#readme",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "(npm run rebuild:electron || echo \"[felixo] rebuild:electron falhou (sem toolchain C++?) — seguindo com o prebuild do node-pty\") && node scripts/dev-runner.cjs",
    "dev:web": "node scripts/dev-runner.cjs --web",
    "rebuild:electron": "electron-rebuild -f -w node-pty",
    "rebuild:node": "npm rebuild node-pty",
    "typecheck": "tsc -b --pretty false",
    "typecheck:full": "tsc -b --pretty false --force",
    "benchmark:typecheck": "node scripts/typecheck-performance.cjs",
    "benchmark:typecheck:check": "npm run benchmark:typecheck -- --check",
    "benchmark:npm-runtime": "node scripts/npm-runtime-performance.cjs",
    "benchmark:npm-runtime:check": "npm run benchmark:npm-runtime -- --check",
    "build": "npm run typecheck && vite build",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "publish:github": "npm run build && electron-builder --publish always",
    "benchmark:terminal": "electron --no-sandbox --disable-gpu --js-flags=--expose-gc --enable-precise-memory-info scripts/terminal-scrollback-benchmark.cjs",
    "benchmark:terminal:check": "npm run benchmark:terminal -- --scrollbacks=20000 --check",
    "benchmark:terminal-output": "node scripts/terminal-output-performance.cjs",
    "benchmark:terminal-output:check": "npm run benchmark:terminal-output -- --check",
    "benchmark:bundle": "electron --no-sandbox --disable-gpu scripts/bundle-load-benchmark.cjs",
    "benchmark:bundle:check": "npm run benchmark:bundle -- --check",
    "benchmark:canvas-connections": "node scripts/canvas-connection-performance.cjs",
    "benchmark:fetch-all": "node scripts/fetch-all-scanner-benchmark.cjs",
    "inventory:package": "node scripts/package-inventory.cjs",
    "release:smoke": "node scripts/release-smoke.cjs",
    "lint": "eslint .",
    "pretest": "npm run rebuild:node",
    "test": "node scripts/run-node-unit-tests.cjs",
    "test:native": "node --test --test-concurrency=1 electron/services/pty-write-queue.integration.test.cjs electron/services/claude-usage-query.integration.test.cjs",
    "test:frontend": "vitest run",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node scripts/start-electron.cjs"
  },
  "build": {
    "appId": "com.felixoverse.felixo-ai-core",
    "productName": "Felixo AI Core",
    "copyright": "Copyright © 2026 Felipe Alcantara",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "public/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ],
    "beforePack": "scripts/bundle-npm-runtime.cjs",
    "afterPack": "scripts/fix-native-pty-permissions.cjs",
    "extraResources": [
      {
        "from": "build/npm-runtime",
        "to": "npm-runtime"
      },
      {
        "from": "resources/skills",
        "to": "skills"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Felipe-Alcantara",
        "repo": "Felixo-AI-Core",
        "releaseType": "prerelease"
      }
    ],
    "fileAssociations": [
      {
        "ext": "fxai",
        "name": "Felixo AI Project",
        "description": "Arquivo de projeto do Felixo AI Core",
        "mimeType": "application/x-felixo-project",
        "role": "Editor"
      },
      {
        "ext": "fxchat",
        "name": "Felixo AI Chat",
        "description": "Chat exportado do Felixo AI Core",
        "mimeType": "application/x-felixo-chat",
        "role": "Viewer"
      },
      {
        "ext": "fxworkflow",
        "name": "Felixo AI Workflow",
        "description": "Workflow do Felixo AI Core",
        "mimeType": "application/x-felixo-workflow",
        "role": "Editor"
      }
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "maintainer": "Felipe Alcantara",
      "mimeTypes": [
        "application/x-felixo-project",
        "application/x-felixo-chat",
        "application/x-felixo-workflow"
      ],
      "artifactName": "Felixo-AI-Core-${version}-${os}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "artifactName": "Felixo-AI-Core-${version}-${os}-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Felixo-AI-Core-${version}-${os}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.11.6",
    "cross-spawn": "^7.0.6",
    "electron-updater": "^6.8.3",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.39.0",
    "node-pty": "^1.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.4",
    "electron": "^41.10.7",
    "electron-builder": "^26.15.3",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "npm": "^11.19.1",
    "playwright-core": "^1.58.2",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "brace-expansion": "^5.0.8"
  },
  "allowScripts": {
    "electron@41.3.0": true,
    "electron-winstaller@5.4.0": true,
    "node-pty@1.1.0": true
  }
}
